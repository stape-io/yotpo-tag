setup: |-
  const JSON = require('JSON');
  const Promise = require('Promise');
  const callLater = require('callLater');
  const Object = require('Object');
  const encodeURIComponent = require('encodeUriComponent');

  const assign = (target, source) => {
    if (!source) return target;
    const keys = Object.keys(source);
    keys.forEach((key) => {
      target[key] = source[key];
    });
    return target;
  };

  const cleanup = () => {
    mock('getAllEventData', () => ({ page_location: 'https://example.com/page' }));
    mock('getRequestHeader', () => undefined);
    mockObject('templateDataStorage', {
      getItemCopy: () => null,
      setItemCopy: () => {}
    });
  };

  cleanup();

  // Default: sendHttpRequest resolves with 200 for any call not otherwise mocked.
  mock('sendHttpRequest', () => Promise.create((resolve) => resolve({ statusCode: 200, body: '{}' })));

  // sha256Sync('yotpo_core_token_' + 'store123' + '_' + 'secret123'), precomputed offline.
  const EXPECTED_CACHE_KEY = 'lG4E7bH0z56TaSg2IMc+fVtgGrDv5C0QgU8gPq3Ojl4=';

  const baseMockData = {
    apiSelect: 'core',
    coreStoreId: 'store123',
    coreApiSecret: 'secret123',
    loyaltyApiKey: 'apiKey123',
    loyaltyGUID: 'guid123',
    useOptimisticScenario: false,
    coreEndpoint: 'createOrUpdateCustomer',
    createOrUpdateCustomerParameters: [{ key: 'customer.external_id', value: 'cust-1' }],
    adStorageConsent: 'optional'
  };

  const createMockData = (overrides) => assign(assign({}, baseMockData), overrides || {});

  const mockData = createMockData();


