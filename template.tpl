- name: '[Optimistic Scenario] Still retries with a fresh token after a 401, even
    though gtmOnSuccess already fired'
  code: |-
    mockData.useOptimisticScenario = true;

    const expectedTokenUrl = 'https://api.yotpo.com/core/v3/stores/' + mockData.coreStoreId + '/access_tokens';
    const expectedCustomersUrl = 'https://api.yotpo.com/core/v3/stores/' + mockData.coreStoreId + '/customers';

    mockObject('templateDataStorage', {
      getItemCopy: () => 'stale-token',
      setItemCopy: () => {}
    });

    let tokenRequestsCount = 0;
    let customersRequestsCount = 0;
    mock('sendHttpRequest', (url, options) => {
      if (url === expectedTokenUrl) {
        tokenRequestsCount++;
        return Promise.create((resolve) =>
          resolve({ statusCode: 200, body: JSON.stringify({ access_token: 'fresh-token' }) })
        );
      }
      if (url === expectedCustomersUrl) {
        customersRequestsCount++;
        if (customersRequestsCount === 1) {
          assertThat(options.headers['X-Yotpo-Token']).isEqualTo('stale-token');
          return Promise.create((resolve) => resolve({ statusCode: 401 }));
        }
        assertThat(options.headers['X-Yotpo-Token']).isEqualTo('fresh-token');
        return Promise.create((resolve) => resolve({ statusCode: 200 }));
      }
    });

    runCode(mockData);

    callLater(() => {
      assertThat(
        tokenRequestsCount,
        'The token should still be refreshed even though the optimistic scenario already reported success.'
      ).isEqualTo(1);
      assertThat(customersRequestsCount, 'The customers endpoint should have been called twice (original + retry).').isEqualTo(2);
      assertApi('gtmOnSuccess').wasCalled();
      assertApi('gtmOnFailure').wasNotCalled();
    });
